{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Helium Docs",
  "description": "Helium is a remote paywall platform for iOS, Android, React Native and Flutter apps: design and edit paywalls without app updates, run A/B tests and targeting, add Stripe or Paddle web checkout (App2Web), and track revenue. These docs cover the mobile SDKs, the dashboard, web checkout, testing and rollout, revenue tracking and analytics forwarding, the Data Access API, and the Helium MCP server.",
  "colors": {
    "primary": "#3b82f6",
    "light": "#60a5fa",
    "dark": "#2563eb"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/LargeLogo-cropped.svg",
    "dark": "/logo/LargeLogo-cropped.svg",
    "href": "https://tryhelium.com"
  },
